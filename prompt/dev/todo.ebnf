(* prompt/dev/todo.ebnf *)

(* ========================================================================== *)
(* HOW TO WRITE A TODO FILE                                                   *)
(* ========================================================================== *)

(*
  Each todo block is a miniature logical reasoning unit.

  PREMISE.
  - known facts, background, or constraints
  - declarative sentence

  GOAL.
  - target proposition or desired state
  - declarative sentence

  ACTIONS.
  - concrete steps to reach the goal
  - imperative sentences

  imperative sentences convey the 5W1H elements naturally.
  the who is an implied entity (the performer), not explicitly stated.
  the remaining elements — what, when, where, why, how — should be clear.

  blocks are separated by a line containing only "---".
  the file begins with an HTML comment block that serves as a permanent
  key‑reference for the reader.
*)

todo
  = header_comment, block_list;

(* ========================================================================== *)
(* HEADER COMMENT                                                             *)
(* ========================================================================== *)

header_comment
  = ? an HTML comment block starting with "<!--" and ending with "-->" ?;

(* ========================================================================== *)
(* BLOCK LIST                                                                 *)
(* ========================================================================== *)

block_list
  = block, { sep, block };

sep
  = "---", eol;

block
  = premise, goal, actions;

premise
  = "PREMISE:", declarative, eol;

goal
  = "GOAL:", declarative, eol;

actions
  = "ACTIONS:", eol, task, { task };

task
  = "- [ ]", imperative, eol;

(* ========================================================================== *)
(* SENTENCE TYPES                                                             *)
(* ========================================================================== *)

(*
  DECLARATIVE.
    a statement of condition or target
    single line, no line breaks

  IMPERATIVE.
  - an imperative sentence covering 5W1H elements
  - the who is implied (an entity: the performer)
  - single line, no line breaks
*)

declarative
  = text;

imperative
  = text;

(* ========================================================================== *)
(* BASIC ELEMENTS                                                             *)
(* ========================================================================== *)

text
  = ? regex:/[^\n\r]+/ ?;

eol
  = "\n"
  | "\r\n";

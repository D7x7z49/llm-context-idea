{
  "name": "pi-ecosystem",
  "private": true,
  "type": "module",
  "description": "pi extensions, skills, and prompts collection",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint . --error-on-warnings",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}

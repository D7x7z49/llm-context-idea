{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noProcessGlobal": "error"
      },
      "security": {
        "noSecrets": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "useBlockStatements": "error",
        "useFilenamingConvention": "error",
        "useNamingConvention": "error"
      },
      "suspicious": {
        "useAwait": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["extensions/*/src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["extensions/wal/src/index.ts", "extensions/scribe/src/index.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "operatorLinebreak": "before",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true
    }
  }
}
